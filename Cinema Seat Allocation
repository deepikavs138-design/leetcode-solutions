#include <vector>
#include <unordered_map>

using namespace std;

class Solution {
public:
    int maxNumberOfFamilies(int n, vector<vector<int>>& reservedSeats) {
        unordered_map<int, int> reserved;
        
        // Populate the bitmask for each reserved row
        for (const auto& seat : reservedSeats) {
            int r = seat[0];
            int c = seat[1];
            
            if (c >= 2 && c <= 5) reserved[r] |= 1; // Mark Left block as unavailable
            if (c >= 4 && c <= 7) reserved[r] |= 2; // Mark Middle block as unavailable
            if (c >= 6 && c <= 9) reserved[r] |= 4; // Mark Right block as unavailable
        }
        
        // Every empty row can hold exactly 2 families
        int ans = (n - reserved.size()) * 2;
        
        for (const auto& [r, mask] : reserved) {
            if (mask == 0) {
                // If the mask is 0, only seats 1 or 10 were occupied.
                // Both Left and Right blocks are completely free.
                ans += 2;
            } else if ((mask & 1) == 0 || (mask & 2) == 0 || (mask & 4) == 0) {
                // If the mask isn't 0, we can't place 2 families.
                // We check if at least ONE of the blocks (Left, Middle, or Right) is free.
                ans += 1;
            }
        }
        
        return ans;
    }
};
