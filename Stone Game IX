#include <bits/stdc++.h>
using namespace std;

class Solution {
public:
    bool stoneGameIX(vector<int>& stones) {
        int cnt[3] = {0};
        for (int s : stones) cnt[s % 3]++;

        if (cnt[0] % 2 == 0) {
            // If count of 0-mod stones is even
            return cnt[1] > 0 && cnt[2] > 0;
        } else {
            // If count of 0-mod stones is odd
            return abs(cnt[1] - cnt[2]) > 2;
        }
    }
};
